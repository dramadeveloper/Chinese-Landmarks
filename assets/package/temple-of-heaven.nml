switch (FEAT_OBJECTS, SELF, toh_world, view) {
    0: toh_tiles_0;
    1: toh_tiles_1;
    2: toh_tiles_2;
    toh_tiles_3;
}
switch (FEAT_OBJECTS, SELF, toh_purchase, view) {
    0: toh_menu_layout_0;
    1: toh_menu_layout_1;
    2: toh_menu_layout_2;
    toh_menu_layout_3;
}
item (FEAT_OBJECTS, temple_of_heaven, 1104) {
    property {
        class: "SHLM";
        name: string(STR_TEMPLE_OF_HEAVEN);
        climates_available: ALL_CLIMATES;
        size: [2,2];
        build_cost_multiplier: 48;
        remove_cost_multiplier: 24;
        introduction_date: date(1751,1,1);
        end_of_life_date: 0xFFFFFFFF;
        object_flags: 0;
        height: 9;
        num_views: 4;
    }
    graphics {
        default: toh_world;
        purchase: toh_purchase;
        tile_check: level_ground_only;
        autoslope: return CB_RESULT_NO_AUTOSLOPE;
    }
}
