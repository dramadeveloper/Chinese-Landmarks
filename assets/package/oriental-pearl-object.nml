item (FEAT_OBJECTS, oriental_pearl, 1102) {
    property {
        class: "SHLM";
        name: string(STR_OBJECT);
        climates_available: ALL_CLIMATES;
        size: [2,2];
        build_cost_multiplier: 40;
        remove_cost_multiplier: 20;
        introduction_date: date(1995,1,1);
        end_of_life_date: 0xFFFFFFFF;
        object_flags: 0;
        height: 31;
        num_views: 4;
    }
    graphics {
        default: world_graphics;
        tile_check: level_ground_only;
        autoslope: return CB_RESULT_NO_AUTOSLOPE;
        purchase: purchase_graphics;
    }
}
