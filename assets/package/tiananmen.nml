switch (FEAT_OBJECTS, SELF, tam_world, view) {
    0: tam_tiles_0;
    1: tam_tiles_1;
    2: tam_tiles_2;
    tam_tiles_3;
}
switch (FEAT_OBJECTS, SELF, tam_purchase, view) {
    0: tam_menu_layout_0;
    1: tam_menu_layout_1;
    2: tam_menu_layout_2;
    tam_menu_layout_3;
}
item (FEAT_OBJECTS, tiananmen, 1103) {
    property {
        class: "SHLM";
        name: string(STR_TIANANMEN);
        climates_available: ALL_CLIMATES;
        size: [8,4];
        build_cost_multiplier: 48;
        remove_cost_multiplier: 24;
        introduction_date: date(1950,1,1);
        end_of_life_date: 0xFFFFFFFF;
        object_flags: 0;
        height: 8;
        num_views: 4;
    }
    graphics {
        default: tam_world;
        purchase: tam_purchase;
        tile_check: level_ground_only;
        autoslope: return CB_RESULT_NO_AUTOSLOPE;
    }
}
